CONFIG_VENDOR_LENOVO=y
CONFIG_BOARD_LENOVO_M920Q=y
CONFIG_USE_BLOBS=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_IFD_BIN_PATH="/path/to/regions/flashregion_0_flashdescriptor.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_ME_BIN_PATH="/path/to/regions/flashregion_2_intel_me.bin"
CONFIG_HAVE_GBE_BIN=y
CONFIG_GBE_BIN_PATH="/path/to/regions/flashregion_3_gbe.bin"
CONFIG_PAYLOAD_EDK2=y
CONFIG_POWER_STATE_OFF_AFTER_FAILURE=y
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y
# CONFIG_PCIEXP_ASPM is not set
# CONFIG_PCIEXP_L1_SUB_STATE is not set
