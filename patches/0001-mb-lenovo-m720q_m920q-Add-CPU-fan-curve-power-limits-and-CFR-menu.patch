 .../lenovo/m720q_m920q/devicetree.cb          | 27 ++++++-
 src/mainboard/lenovo/m720q_m920q/fan.c        | 56 ++++++++++++++
 .../m720q_m920q/include/mainboard/fan.h       | 15 ++++
 src/mainboard/lenovo/m720q_m920q/ramstage.c   |  2 +
 src/superio/nuvoton/nct6687d/nct6687d_hwm.c   | 17 ++++
 8 files changed, 195 insertions(+), 2 deletions(-)
 create mode 100644 src/mainboard/lenovo/m720q_m920q/cfr.c
 create mode 100644 src/mainboard/lenovo/m720q_m920q/fan.c
